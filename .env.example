# ─── Database (Supabase) ──────────────────────────────────────────────────────
# Get both strings from: Supabase Dashboard → Project Settings → Database → Connection string

# Transaction mode via PgBouncer — used at runtime (port 6543)
# IMPORTANT: URL-encode special chars in your password, e.g. # → %23
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"

# Session mode — used by Prisma for migrations (port 5432, same host)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# ─── Auth.js ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# ─── Bootstrap admin ─────────────────────────────────────────────────────────
# This @liu.edu.lb email is automatically granted ADMIN role on first login
ADMIN_BOOTSTRAP_EMAIL="your-email@liu.edu.lb"
