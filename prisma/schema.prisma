generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String         @id @default(cuid())
  name           String?
  email          String         @unique
  emailVerified  DateTime?
  image          String?
  role           Role           @default(PROFESSOR)
  campusId       String?
  departmentId   String?
  createdAt      DateTime       @default(now())
  accounts       Account[]
  leaveRequests  LeaveRequest[] @relation("ProfessorLeaves")
  reviewedLeaves LeaveRequest[] @relation("ReviewedLeaves")
  campus         Campus?        @relation(fields: [campusId], references: [id])
  department     Department?    @relation(fields: [departmentId], references: [id])

  @@index([campusId])
  @@index([departmentId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Campus {
  id    String @id @default(cuid())
  name  String @unique
  users User[]
}

model Department {
  id    String @id @default(cuid())
  name  String @unique
  users User[]
}

model AppSettings {
  id                     String   @id @default("global")
  submissionsOpen        Boolean  @default(true)
  maxLeaveDays           Int      @default(22)
  campusOverlapThreshold Int      @default(3)
  deptOverlapEnabled     Boolean  @default(true)
  deptOverlapThreshold   Int      @default(2)
  updatedAt              DateTime @updatedAt
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime
  label     String?
  createdAt DateTime @default(now())

  @@index([date])
}

model LeaveRequest {
  id           String      @id @default(cuid())
  professorId  String
  dates        DateTime[]
  status       LeaveStatus @default(PENDING)
  adminComment String?
  submittedAt  DateTime    @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  professor    User        @relation("ProfessorLeaves", fields: [professorId], references: [id], onDelete: Cascade)
  reviewedBy   User?       @relation("ReviewedLeaves", fields: [reviewedById], references: [id])

  @@index([professorId])
  @@index([status])
  @@index([submittedAt])
}

enum Role {
  PROFESSOR
  DEAN
  COORDINATOR
  ASSISTANT_DEAN
  CHAIRMAN
  SUPER_ADMIN
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  STEP1_APPROVED
  STEP1_REJECTED
  STEP2_APPROVED
  STEP2_REJECTED
}
